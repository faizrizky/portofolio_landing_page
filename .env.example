# Database. WAJIB Postgres (schema.prisma sudah di-set provider =
# "postgresql") — SQLite gak dipakai lagi, baik lokal maupun production.
# Cara paling gampang: pakai project Supabase yang sama buat lokal & prod
# (untuk portofolio pribadi gak masalah, gak perlu database terpisah).
#
# Buka Vercel -> project kamu -> Storage -> Supabase store yang connect ->
# tab ".env.local", terus:
#   DATABASE_URL  = isi dari POSTGRES_PRISMA_URL   (koneksi pooled, dipakai runtime)
#   DIRECT_URL    = isi dari POSTGRES_URL_NON_POOLING, atau kalau gak ada,
#                   pakai POSTGRES_URL              (koneksi langsung, dipakai migration)
DATABASE_URL=""
DIRECT_URL=""

# Admin login
ADMIN_USERNAME="admin"
# Generate hash-nya dengan: npm run hash-password -- "password_kamu"
# PENTING: Next.js expand pola $xxx di .env, jadi tanda $ di hash bcrypt
# harus di-escape jadi \$ (script hash-password.ts sudah otomatis kasih
# format yang benar, tinggal copy-paste).
ADMIN_PASSWORD_HASH="\$2a\$10\$contohcontohcontohcontohcontohcontohcontohcontoh"

# Ganti dengan string acak yang panjang (misal: openssl rand -base64 32)
JWT_SECRET="ganti-dengan-secret-yang-panjang-dan-acak"

# Domain tempat landing page (repo terpisah) di-deploy. Dipakai untuk CORS
# supaya landing page boleh fetch /api/projects dan /api/profile dari sini.
# Waktu development boleh dikosongkan / pakai "*".
LANDING_PAGE_URL="https://portofolio-kamu.vercel.app"

# Dipakai fitur "upload file" di admin panel (cover image, screenshots,
# gambar di dalam description). Cara dapatnya:
# 1. Buka project kamu di dashboard Vercel -> tab Storage -> Create Database -> Blob
# 2. Setelah dibuat, di production token ini otomatis ke-inject ke env Vercel
# 3. Untuk dev lokal, copy token-nya dari Storage -> Blob store -> .env.local tab
BLOB_READ_WRITE_TOKEN=""
